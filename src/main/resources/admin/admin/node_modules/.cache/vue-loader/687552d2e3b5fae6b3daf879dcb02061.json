{"remainingRequest":"D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\src\\views\\modules\\gonggao\\list.vue?vue&type=style&index=0&id=069e20f4&prod&lang=scss&scoped=true","dependencies":[{"path":"D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\src\\views\\modules\\gonggao\\list.vue","mtime":1778211927179},{"path":"D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\node_modules\\css-loader\\dist\\cjs.js","mtime":1783438476496},{"path":"D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1783438477612},{"path":"D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\node_modules\\postcss-loader\\src\\index.js","mtime":1783438476923},{"path":"D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\node_modules\\sass-loader\\dist\\cjs.js","mtime":1783438476171},{"path":"D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1783438476180},{"path":"D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\node_modules\\vue-loader\\lib\\index.js","mtime":1783438477271}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:Ci5mb3JtLWNvbnRlbnQsCi50b29sYmFyLWNvbnRlbnQgewogIG1hcmdpbi1ib3R0b206IDEycHg7Cn0KCi5kYW5nZXItdGV4dCB7CiAgY29sb3I6ICNmNTZjNmM7Cn0KCi5wYWdpbmF0aW9uLWNvbnRlbnQgewogIG1hcmdpbi10b3A6IDE2cHg7CiAgdGV4dC1hbGlnbjogcmlnaHQ7Cn0K"},{"version":3,"sources":["list.vue"],"names":[],"mappings":";AAyQA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA","file":"list.vue","sourceRoot":"src/views/modules/gonggao","sourcesContent":["<template>\n  <div class=\"main-content\">\n    <div v-if=\"showFlag\">\n      <el-form :inline=\"true\" :model=\"searchForm\" class=\"form-content\">\n        <el-form-item label=\"公告名称\">\n          <el-input v-model=\"searchForm.gonggaoName\" placeholder=\"请输入公告名称\" clearable />\n        </el-form-item>\n        <el-form-item label=\"公告类型\">\n          <el-select v-model=\"searchForm.gonggaoTypes\" placeholder=\"请选择公告类型\" clearable>\n            <el-option\n              v-for=\"item in gonggaoTypesOptions\"\n              :key=\"item.codeIndex\"\n              :label=\"item.indexName\"\n              :value=\"item.codeIndex\"\n            />\n          </el-select>\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" icon=\"el-icon-search\" @click=\"search\">查询</el-button>\n          <el-button @click=\"resetSearch\">重置</el-button>\n        </el-form-item>\n      </el-form>\n\n      <el-form :inline=\"true\" class=\"toolbar-content\">\n        <el-form-item>\n          <el-button type=\"success\" icon=\"el-icon-plus\" @click=\"addOrUpdateHandler()\">新增公告</el-button>\n          <el-button\n            type=\"danger\"\n            icon=\"el-icon-delete\"\n            :disabled=\"dataListSelections.length === 0\"\n            @click=\"deleteHandler()\"\n          >批量删除</el-button>\n        </el-form-item>\n      </el-form>\n\n      <div class=\"table-content\">\n        <el-table\n          class=\"tables\"\n          :data=\"dataList\"\n          border\n          stripe\n          v-loading=\"dataListLoading\"\n          @selection-change=\"selectionChangeHandler\"\n        >\n          <el-table-column type=\"selection\" width=\"50\" align=\"center\" />\n          <el-table-column type=\"index\" label=\"#\" width=\"60\" align=\"center\" />\n          <el-table-column prop=\"gonggaoName\" label=\"公告名称\" min-width=\"180\" />\n          <el-table-column prop=\"gonggaoValue\" label=\"公告类型\" min-width=\"110\" />\n          <el-table-column prop=\"insertTime\" label=\"发布时间\" min-width=\"170\" />\n          <el-table-column prop=\"gonggaoContent\" label=\"公告详情\" min-width=\"220\" show-overflow-tooltip>\n            <template slot-scope=\"scope\">\n              <span>{{ stripHtml(scope.row.gonggaoContent) }}</span>\n            </template>\n          </el-table-column>\n          <el-table-column label=\"操作\" width=\"210\" align=\"center\" fixed=\"right\">\n            <template slot-scope=\"scope\">\n              <el-button type=\"text\" @click=\"addOrUpdateHandler(scope.row.id, 'info')\">详情</el-button>\n              <el-button type=\"text\" @click=\"addOrUpdateHandler(scope.row.id, 'edit')\">编辑</el-button>\n              <el-button type=\"text\" class=\"danger-text\" @click=\"deleteHandler(scope.row.id)\">删除</el-button>\n            </template>\n          </el-table-column>\n        </el-table>\n\n        <el-pagination\n          class=\"pagination-content\"\n          layout=\"total, sizes, prev, pager, next, jumper\"\n          :current-page=\"pageIndex\"\n          :page-sizes=\"[10, 20, 50, 100]\"\n          :page-size=\"pageSize\"\n          :total=\"totalPage\"\n          @size-change=\"sizeChangeHandle\"\n          @current-change=\"currentChangeHandle\"\n        />\n      </div>\n    </div>\n\n    <add-or-update v-if=\"addOrUpdateFlag\" ref=\"addOrUpdate\" :parent=\"this\" />\n  </div>\n</template>\n\n<script>\nimport AddOrUpdate from './add-or-update'\n\nexport default {\n  components: { AddOrUpdate },\n  data() {\n    return {\n      showFlag: true,\n      addOrUpdateFlag: false,\n      lastOpenedStorageKey: '',\n      searchForm: {\n        gonggaoName: '',\n        gonggaoTypes: ''\n      },\n      gonggaoTypesOptions: [],\n      dataList: [],\n      dataListLoading: false,\n      dataListSelections: [],\n      pageIndex: 1,\n      pageSize: 10,\n      totalPage: 0\n    }\n  },\n  created() {\n    this.loadGonggaoTypes()\n    this.getDataList()\n    this.tryOpenPendingDetail()\n  },\n  mounted() {\n    this.tryOpenPendingDetail()\n  },\n  watch: {\n    '$route.fullPath'() {\n      this.tryOpenPendingDetail()\n    }\n  },\n  methods: {\n    stripHtml(content) {\n      if (!content) return ''\n      return content.replace(/<[^>]*>/g, '').replace(/\\s+/g, ' ').trim()\n    },\n    resetSearch() {\n      this.searchForm = {\n        gonggaoName: '',\n        gonggaoTypes: ''\n      }\n      this.search()\n    },\n    search() {\n      this.pageIndex = 1\n      this.getDataList()\n    },\n    loadGonggaoTypes() {\n      this.$http({\n        url: 'dictionary/page',\n        method: 'get',\n        params: {\n          page: 1,\n          limit: 100,\n          dicCode: 'gonggao_types'\n        }\n      }).then(({ data }) => {\n        if (data && data.code === 0) {\n          this.gonggaoTypesOptions = data.data.list || []\n        }\n      })\n    },\n    getDataList() {\n      this.dataListLoading = true\n      const params = {\n        page: this.pageIndex,\n        limit: this.pageSize,\n        sort: 'id',\n        order: 'desc'\n      }\n      if (this.searchForm.gonggaoName) {\n        params.gonggaoName = `%${this.searchForm.gonggaoName}%`\n      }\n      if (this.searchForm.gonggaoTypes !== '' && this.searchForm.gonggaoTypes !== null) {\n        params.gonggaoTypes = this.searchForm.gonggaoTypes\n      }\n      this.$http({\n        url: 'gonggao/page',\n        method: 'get',\n        params\n      }).then(({ data }) => {\n        if (data && data.code === 0) {\n          this.dataList = data.data.list || []\n          this.totalPage = data.data.total || 0\n        } else {\n          this.dataList = []\n          this.totalPage = 0\n          this.$message.error(data.msg || '加载失败')\n        }\n      }).finally(() => {\n        this.dataListLoading = false\n        this.tryOpenPendingDetail()\n      })\n    },\n    sizeChangeHandle(val) {\n      this.pageSize = val\n      this.pageIndex = 1\n      this.getDataList()\n    },\n    currentChangeHandle(val) {\n      this.pageIndex = val\n      this.getDataList()\n    },\n    selectionChangeHandler(val) {\n      this.dataListSelections = val\n    },\n    addOrUpdateHandler(id, type) {\n      this.showFlag = false\n      this.addOrUpdateFlag = true\n      this.$nextTick(() => {\n        this.$refs.addOrUpdate.init(id, type || 'edit')\n      })\n    },\n    tryOpenFromStorage() {\n      const openId = this.$storage.get('pendingGonggaoOpenId')\n      const openType = this.$storage.get('pendingGonggaoOpenType') || 'info'\n      const parsedId = Number(openId)\n      if (!parsedId) return false\n      const storageKey = String(parsedId) + ':' + String(openType)\n      if (this.lastOpenedStorageKey === storageKey && this.addOrUpdateFlag) return true\n      this.lastOpenedStorageKey = storageKey\n      this.$nextTick(() => {\n        this.addOrUpdateHandler(parsedId, openType)\n        this.$storage.remove('pendingGonggaoOpenId')\n        this.$storage.remove('pendingGonggaoOpenType')\n      })\n      return true\n    },\n    tryOpenFromRoute() {\n      const openId = this.$route && this.$route.query ? this.$route.query.openId : ''\n      const openType = this.$route && this.$route.query ? this.$route.query.openType : ''\n      const parsedId = Number(openId)\n      if (!parsedId) return false\n      const routeKey = 'route:' + String(parsedId) + ':' + String(openType || 'info')\n      if (this.lastOpenedStorageKey === routeKey && this.addOrUpdateFlag) return true\n      this.lastOpenedStorageKey = routeKey\n      this.$nextTick(() => {\n        this.addOrUpdateHandler(parsedId, openType || 'info')\n        this.clearRouteOpenQuery()\n      })\n      return true\n    },\n    tryOpenPendingDetail() {\n      if (this.tryOpenFromStorage()) return\n      this.tryOpenFromRoute()\n    },\n    clearRouteOpenQuery() {\n      if (!(this.$route && this.$route.query && this.$route.query.openId)) return\n      this.$router.replace({\n        path: this.$route.path,\n        query: {}\n      }).catch(() => {})\n    },\n    deleteHandler(id) {\n      const ids = id ? [Number(id)] : this.dataListSelections.map(item => Number(item.id))\n      if (!ids.length) return\n      this.$confirm('确定删除选中的公告吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.$http({\n          url: 'gonggao/delete',\n          method: 'post',\n          data: ids\n        }).then(({ data }) => {\n          if (data && data.code === 0) {\n            this.$message.success('删除成功')\n            this.search()\n          } else {\n            this.$message.error(data.msg || '删除失败')\n          }\n        })\n      }).catch(() => {})\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.form-content,\n.toolbar-content {\n  margin-bottom: 12px;\n}\n\n.danger-text {\n  color: #f56c6c;\n}\n\n.pagination-content {\n  margin-top: 16px;\n  text-align: right;\n}\n</style>\n"]}]}