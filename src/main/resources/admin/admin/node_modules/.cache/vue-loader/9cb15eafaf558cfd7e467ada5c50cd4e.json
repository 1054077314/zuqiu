{"remainingRequest":"D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\src\\views\\modules\\dictionaryShuju\\add-or-update.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\src\\views\\modules\\dictionaryShuju\\add-or-update.vue","mtime":1773973566000},{"path":"D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1774436653634},{"path":"D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\node_modules\\babel-loader\\lib\\index.js","mtime":1774436655080},{"path":"D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1774436653634},{"path":"D:\\eclipse\\HOME\\zuqiu\\src\\main\\resources\\admin\\admin\\node_modules\\vue-loader\\lib\\index.js","mtime":1774436655754}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["add-or-update.vue"],"names":[],"mappings":";AAoDA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"add-or-update.vue","sourceRoot":"src/views/modules/dictionaryShuju","sourcesContent":["<template>\n  <div class=\"addEdit-block\">\n    <el-form\n      ref=\"ruleForm\"\n      :model=\"ruleForm\"\n      :rules=\"rules\"\n      label-width=\"110px\"\n      class=\"detail-form-content\"\n    >\n      <el-row :gutter=\"16\">\n        <el-col :span=\"12\">\n          <el-form-item label=\"编码\" prop=\"codeIndex\">\n            <el-input\n              v-model=\"ruleForm.codeIndex\"\n              readonly\n              placeholder=\"系统自动生成\"\n            />\n          </el-form-item>\n        </el-col>\n\n        <el-col :span=\"12\">\n          <el-form-item label=\"球员数据类型名称\" prop=\"indexName\">\n            <el-input\n              v-model=\"ruleForm.indexName\"\n              :readonly=\"type === 'info'\"\n              placeholder=\"请输入球员数据类型名称\"\n              clearable\n            />\n          </el-form-item>\n        </el-col>\n\n        <el-col :span=\"24\">\n          <el-form-item label=\"备注\" prop=\"beizhu\">\n            <el-input\n              v-model=\"ruleForm.beizhu\"\n              :readonly=\"type === 'info'\"\n              placeholder=\"请输入备注（可选）\"\n              clearable\n            />\n          </el-form-item>\n        </el-col>\n      </el-row>\n\n      <el-form-item class=\"btn\">\n        <el-button v-if=\"type !== 'info'\" type=\"primary\" @click=\"onSubmit\">保存</el-button>\n        <el-button @click=\"back\">{{ type === 'info' ? '返回' : '取消' }}</el-button>\n      </el-form-item>\n    </el-form>\n  </div>\n</template>\n\n<script>\nconst DIC_CODE = 'shuju_types'\nconst DIC_NAME = '球员数据类型'\n\nexport default {\n  props: ['parent'],\n  data() {\n    return {\n      id: null,\n      type: 'edit',\n      ruleForm: {\n        id: '',\n        dicCode: DIC_CODE,\n        dicName: DIC_NAME,\n        codeIndex: '',\n        indexName: '',\n        superId: 0,\n        beizhu: ''\n      },\n      rules: {\n        codeIndex: [{ required: true, message: '编码不能为空', trigger: 'blur' }],\n        indexName: [{ required: true, message: '请输入名称', trigger: 'blur' }]\n      }\n    }\n  },\n  methods: {\n    init(id, type) {\n      this.id = id || null\n      this.type = type || 'edit'\n      this.ruleForm = {\n        id: '',\n        dicCode: DIC_CODE,\n        dicName: DIC_NAME,\n        codeIndex: '',\n        indexName: '',\n        superId: 0,\n        beizhu: ''\n      }\n      if (this.id) {\n        this.info(this.id)\n      } else {\n        this.loadMaxCodeIndex()\n      }\n    },\n    loadMaxCodeIndex() {\n      this.$http({\n        url: 'dictionary/maxCodeIndex',\n        method: 'post',\n        data: { dicCode: DIC_CODE }\n      }).then(({ data }) => {\n        if (data && data.code === 0) {\n          this.ruleForm.codeIndex = data.maxCodeIndex\n        } else {\n          this.$message.error(data.msg || '获取编码失败')\n        }\n      })\n    },\n    info(id) {\n      this.$http({\n        url: `dictionary/info/${id}`,\n        method: 'get'\n      }).then(({ data }) => {\n        if (data && data.code === 0) {\n          this.ruleForm = Object.assign(\n            {\n              id: '',\n              dicCode: DIC_CODE,\n              dicName: DIC_NAME,\n              codeIndex: '',\n              indexName: '',\n              superId: 0,\n              beizhu: ''\n            },\n            data.data || {}\n          )\n        } else {\n          this.$message.error(data.msg || '加载失败')\n        }\n      })\n    },\n    onSubmit() {\n      this.$refs.ruleForm.validate(valid => {\n        if (!valid) return\n        const formData = {\n          ...this.ruleForm,\n          dicCode: DIC_CODE,\n          dicName: DIC_NAME,\n          superId: this.ruleForm.superId || 0\n        }\n        this.$http({\n          url: `dictionary/${!formData.id ? 'save' : 'update'}`,\n          method: 'post',\n          data: formData\n        }).then(({ data }) => {\n          if (data && data.code === 0) {\n            this.$message.success('保存成功')\n            this.parent.showFlag = true\n            this.parent.addOrUpdateFlag = false\n            this.parent.getDataList()\n          } else {\n            this.$message.error(data.msg || '保存失败')\n          }\n        })\n      })\n    },\n    back() {\n      this.parent.showFlag = true\n      this.parent.addOrUpdateFlag = false\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.detail-form-content {\n  padding: 8px 4px;\n}\n</style>\n\n"]}]}