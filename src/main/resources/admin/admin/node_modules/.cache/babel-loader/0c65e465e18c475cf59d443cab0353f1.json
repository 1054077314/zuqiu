assword\n        this.user.mima = this.ruleForm.newpassword\n\n        this.$http({\n          url: `${this.$storage.get('sessionTable')}/update`,\n          method: 'post',\n          data: this.user\n        }).then(({ data }) => {\n          if (data && data.code === 0) {\n            this.$message.success('密码修改成功，下次登录生效')\n            this.ruleForm = {\n              password: '',\n              newpassword: '',\n              repassword: ''\n            }\n          } else {\n            this.$message.error(data.msg || '密码修改失败')\n          }\n        })\n      })\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n</style>\n"],"mappings":"AA0BA;EACAA,IAAA,WAAAA,KAAA;IACA;MACAC,QAAA;QACAC,QAAA;QACAC,WAAA;QACAC,UAAA;MACA;MACAC,IAAA;MACAC,KAAA;QACAJ,QAAA;UAAAK,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAN,WAAA;UAAAI,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAL,UAAA;UAAAG,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IAAA,IAAAC,KAAA;IACA,KAAAC,KAAA;MACAC,GAAA,KAAAC,MAAA,MAAAC,QAAA,CAAAC,GAAA;MACAC,MAAA;IACA,GAAAC,IAAA,WAAAC,IAAA;MAAA,IAAAnB,IAAA,GAAAmB,IAAA,CAAAnB,IAAA;MACA,IAAAA,IAAA,IAAAA,IAAA,CAAAoB,IAAA;QACAT,KAAA,CAAAN,IAAA,GAAAL,IAAA,CAAAA,IAAA;MACA;QACAW,KAAA,CAAAU,QAAA,CAAAC,KAAA,CAAAtB,IAAA,CAAAuB,GAAA;MACA;IACA;EACA;EACAC,OAAA;IACAC,eAAA,WAAAA,gBAAA;MAAA,IAAAC,MAAA;MACA,KAAAC,KAAA,CAAA1B,QAAA,CAAA2B,QAAA,WAAAC,KAAA;QACA,KAAAA,KAAA;QAEA,IAAAC,WAAA,GAAAJ,MAAA,CAAArB,IAAA,CAAA0B,IAAA,IAAAL,MAAA,CAAArB,IAAA,CAAAH,QAAA;QACA,IAAAwB,MAAA,CAAAzB,QAAA,CAAAC,QAAA,KAAA4B,WAAA;UACAJ,MAAA,CAAAL,QAAA,CAAAC,KAAA;UACA;QACA;QACA,IAAAI,MAAA,CAAAzB,QAAA,CAAAE,WAAA,CAAA6B,MAAA;UACAN,MAAA,CAAAL,QAAA,CAAAC,KAAA;UACA;QACA;QACA,IAAAI,MAAA,CAAAzB,QAAA,CAAAE,WAAA,KAAAuB,MAAA,CAAAzB,QAAA,CAAAG,UAAA;UACAsB,MAAA,CAAAL,QAAA,CAAAC,KAAA;UACA;QACA;QAEAI,MAAA,CAAArB,IAAA,CAAAH,QAAA,GAAAwB,MAAA,CAAAzB,QAAA,CAAAE,WAAA;QACAuB,MAAA,CAAArB,IAAA,CAAA0B,IAAA,GAAAL,MAAA,CAAAzB,QAAA,CAAAE,WAAA;QAEAuB,MAAA,CAAAd,KAAA;UACAC,GAAA,KAAAC,MAAA,CAAAY,MAAA,CAAAX,QAAA,CAAAC,GAAA;UACAC,MAAA;U