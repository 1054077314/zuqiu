ple=\"true\"\n              :fileUrls=\"ruleForm.value ? toImageUrl(ruleForm.value) : ''\"\n              @change=\"valueUploadChange\"\n            />\n          </el-form-item>\n        </el-col>\n      </el-row>\n\n      <el-form-item class=\"btn\">\n        <el-button v-if=\"type !== 'info'\" type=\"primary\" @click=\"onSubmit\">保存</el-button>\n        <el-button @click=\"back\">{{ type === 'info' ? '返回' : '取消' }}</el-button>\n      </el-form-item>\n    </el-form>\n  </div>\n</template>\n\n<script>\nexport default {\n  props: ['parent'],\n  data() {\n    return {\n      id: null,\n      type: 'edit',\n      ruleForm: {\n        id: '',\n        name: '',\n        value: ''\n      },\n      rules: {\n        name: [{ required: true, message: '请输入轮播图名称', trigger: 'blur' }],\n        value: [{ required: true, message: '请至少上传一张轮播图', trigger: 'change' }]\n      }\n    }\n  },\n  methods: {\n    toImageUrl(path) {\n      if (!path) return ''\n      return /^https?:\\/\\//i.test(path) ? path : this.$base.url + path\n    },\n    parseImages(value) {\n      if (!value) return []\n      return String(value)\n        .split(',')\n        .map(item => item.trim())\n        .filter(Boolean)\n    },\n    init(id, type) {\n      this.id = id || null\n      this.type = type || 'edit'\n      this.ruleForm = {\n        id: '',\n        name: '',\n        value: ''\n      }\n      if (this.id) {\n        this.info(this.id)\n      }\n    },\n    info(id) {\n      this.$http({\n        url: 'config/info/' + id,\n        method: 'get'\n      }).then(({ data }) => {\n        if (data && data.code === 0) {\n          this.ruleForm = Object.assign({\n            id: '',\n            name: '',\n            value: ''\n          }, data.data || {})\n        } else {\n          this.$message.error((data && data.msg) || '加载失败')\n        }\n      })\n    },\n    valueUploadChange(fileUrls) {\n      this.ruleForm.value = fileUrls\n      if (this.$refs.ruleForm) {\n        this.$refs.ruleForm.validateField('value')\n      }\n    },\n    onSubmit() {\n      this.$refs.ruleForm.validate(valid => {\n        if (!valid) return\n        const formData = Object.assign({}, this.ruleForm)\n        this.$http({\n          url: 'config/' + (!formData.id ? 'save' : 'update'),\n          method: 'post',\n          data: formData\n        }).then(({ data }) => {\n          if (data && data.code === 0) {\n            this.$message.success('保存成功')\n            this.parent.showFlag = true\n            this.parent.addOrUpdateFlag = false\n            this.parent.getDataList()\n          } else {\n            this.$message.error((data && data.msg) || '保存失败')\n          }\n        })\n      })\n    },\n    back() {\n      this.parent.showFlag = true\n      this.parent.addOrUpdateFlag = false\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.banner-edit-page {\n  .form-intro {\n    margin-bottom: 14px;\n    padding: 16px 18px;\n    border-radius: 18px;\n    background: linear-gradient(180deg, #f8fbff, #eef5ff);\n    border: 1px solid #d9e7f8;\n  }\n\n  .form-intro h3 {\n    margin: 0;\n    color: #163f65;\n    font-size: 22px;\n  }\n\n  .form-intro p {\n    margin: 6px 0 0;\n    color: #6b86a1;\n    font-size: 13px;\n  }\n\n  .upload-tip {\n    margin-bottom: 10px;\n    color: #6a8096;\n    font-size: 13px;\n  }\n\n  .preview-wrap {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px;\n  }\n\n  .preview-card {\n    position: relative;\n    width: 168px;\n    height: 108px;\n    border-radius: 14px;\n    overflow: hidden;\n    border: 1px solid #d9e7f8;\n    background: #f3f8fe;\n  }\n\n  .preview-image {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  .preview-order {\n    position: absolute;\n    left: 10px;\n    top: 10px;\n    min-width: 56px;\n    height: 26px;\n    padding: 0 10px;\n    border-radius: 999px;\n    background: rgba(7, 34, 65, 0.72);\n    color: #fff;\n    font-size: 12px;\n    line-height: 26px;\n    text-align: center;\n  }\n\n  .empty-inline {\n    color: #6d87a0;\n  }\n}\n</style>\n"],"mappings":";;;;;;;;;AAsEA;EACAA,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,EAAA;MACAC,IAAA;MACAC,QAAA;QACAF,EAAA;QACAG,IAAA;QACAC,KAAA;MACA;MACAC,KAAA;QACAF,IAAA;UAAAG,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAJ,KAAA;UAAAE,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;IACA;EACA;EACAC,OAAA;IACAC,UAAA,WAAAA,WAAAC,IAAA;MACA,KAAAA,IAAA;MACA,uBAAAC,IAAA,CAAAD,IAAA,IAAAA,IAAA,QAAAE,KAAA,CAAAC,GAAA,GAAAH,IAAA;IACA;IACAI,WAAA,WAAAA,YAAAX,KAAA;MACA,KAAAA,KAAA;MACA,OAAAY,MAAA,CAAAZ,KAAA,EACAa,KAAA,MACAC,GAAA,WAAAC,IAAA;QAAA,OAAAA,IAAA,CAAAC,IAAA;MAAA,GACAC,MAAA,CAAAC,OAAA;IACA;IACAC,IAAA,WAAAA,KAAAvB,EAAA,EAAAC,IAAA;MACA,KAAAD,EAAA,GAAAA,EAAA;MACA,KAAAC,IAAA,GAAAA,IAAA;MACA,KAAAC,QAAA;QACAF,EAAA;QACAG,IAAA;QACAC,KAAA;MACA;MACA,SAAAJ,EAAA;QACA,KAAAwB,IAAA,MAAAxB,EAAA;MACA;IACA;IACAwB,IAAA,WAAAA,KAAAxB,EAAA;MAAA,IAAAyB,KAAA;MACA,KAAAC,KAAA;QACAZ,GAAA,mBAAAd,EAAA;QACA2B,MAAA;MACA,GAAAC,IAAA,WAAAC,IAAA;QAAA,IAAA9B,IAAA,GAAA8B,IAAA,CAAA9B,IAAA;QACA,IAAAA,IAAA,IAAAA,IAAA,CAAA+B,IAAA;UACAL,KAAA,CAAAvB,QAAA,GAAA6B,MAAA,CAAAC,MAAA;YACAhC,EAAA;YACAG,IAAA;YACAC,KAAA;UACA,GAAAL,IAAA,CAAAA,IAAA;QACA;UACA0B,KAAA,CAAAQ,QAAA,CAAAC,KAAA,CAAAnC,IAAA,IAAAA,IAAA,CAAAoC,GAAA;QACA;MACA;IACA;IACAC,iBAAA,WAAAA,kBAAAC,QAAA;MACA,KAAAnC,QAAA,CAAAE,KAAA,GAAAiC,QAAA;MACA,SAAAC,KAAA,CAAApC,QAAA;QACA,KAAAoC,KAAA,CAAApC,QAAA,CAAAqC,aAAA;MACA;IACA;IACAC,QAAA,WAAAA,SAAA;MAAA,IAAAC,MAAA;MACA,KAAAH,KAAA,CAAApC,QAAA,CAAAwC,QAAA,WAAAC,KAAA;QACA,KAAAA,KAAA;QACA,IAAAC,QAAA,GAAAb,MAAA,CAAAC,MAAA,KAAAS,MAAA,CAAAvC,QAAA;QACAuC,MAAA,CAAAf,KAAA;UACAZ,GAAA,gBAAA8B,QAAA,CAAA5C,EAAA;UACA2B,MAAA;UACA5B,IAAA,EAAA6C;QACA,GAAAhB,IAAA,WAAAiB,KAAA;UAAA,IAAA9C,IAAA,GAAA8C,KAAA,CAAA9C,IAAA;UACA,IAAAA,IAAA,IAAAA,IAAA,CAAA+B,IAAA;YACAW,MAAA,CAAAR,QAAA,CAAAa,OAAA;YACAL,MAAA,CAAAM,MAAA,CAAAC,QAAA;YACAP,MAAA,CAAAM,MAAA,CAAAE,eAAA;YACAR,MAAA,CAAAM,MAAA,CAAAG,WAAA;UACA;YACAT,MAAA,CAAAR,QAAA,CAAAC,KAAA,CAAAnC,IAAA,IAAAA,IAAA,CAAAoC,GAAA;UACA;QACA;MACA;IACA;IACAgB,IAAA,WAAAA,KAAA;MACA,KA